{
  "name": "default",
  "version": 3,
  "description": "Dynamic GitHub CI discovery with no globally required check names.",
  "auto_approval_risk_threshold": 39,
  "auto_merge_allowed_risk_categories": [
    "LOW"
  ],
  "mandatory_ci_checks": [],
  "ci_check_aliases": {},
  "blocked_paths": [
    "**/secrets/**",
    "**/*.pem",
    "**/*.key",
    "**/.env",
    "infra/prod/**",
    "**/migrations/**prod**"
  ],
  "human_review_required_paths": [
    "**/auth/**",
    "**/payments/**",
    "**/billing/**",
    "**/.github/workflows/**",
    "**/Dockerfile",
    "**/docker-compose*.yml"
  ],
  "max_files_for_auto_approval": 25,
  "disallowed_authors": [],
  "circuit_breaker_conditions": {
    "auto_trip_on_critical_finding": true,
    "auto_trip_after_n_blocked_prs": 3,
    "auto_trip_window_minutes": 60
  }
}
