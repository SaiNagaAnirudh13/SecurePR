# Copy to backend/.env for local development. Replace placeholders locally.
# Never store real credentials in this file or commit backend/.env.

# Supabase PostgreSQL
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.example.supabase.co:5432/postgres?sslmode=require

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_JWT_ALGORITHM=ES256
SUPABASE_AUTH_AUDIENCE=authenticated
# Required only for legacy HS256 signing; keep this backend-only.
SUPABASE_JWT_SECRET=
SECUREPR_OPERATOR_IDS=
SECUREPR_ADMIN_IDS=

# GitHub App
GITHUB_APP_ID=your-github-app-id
# Prefer GITHUB_PRIVATE_KEY as a backend secret in production.
GITHUB_PRIVATE_KEY=
# Local development fallback when GITHUB_PRIVATE_KEY is unset.
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
GITHUB_WEBHOOK_SECRET=replace-with-a-long-random-webhook-secret

# Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_SECONDS=20

# Application
SECUREPR_ENV=development
SECUREPR_BASE_URL=http://localhost:8000
DASHBOARD_ORIGIN=http://localhost:5173
DASHBOARD_ORIGINS=

# Optional notifications
NOTIFY_WEBHOOK_URL=

# CI wait behavior
CI_WAIT_POLL_INTERVAL_SECONDS=20
CI_WAIT_TIMEOUT_SECONDS=900
CI_DISCOVERY_STABILIZATION_SECONDS=30
POST_CI_WAITING_COMMENT=true

# Auto-merge remains opt-in; enable only after reviewing its safeguards.
AUTO_MERGE_ENABLED=false
AUTO_MERGE_LOW_RISK_ONLY=true
AUTO_MERGE_REQUIRE_ALL_CI=true

# Optional policy weight overrides
RISK_WEIGHT_CHANGE_SURFACE=0.20
RISK_WEIGHT_REVERSIBILITY=0.15
RISK_WEIGHT_DATA_SECURITY=0.25
RISK_WEIGHT_OPERATIONAL=0.15
RISK_WEIGHT_VERIFICATION=0.15
RISK_WEIGHT_POLICY_COMPLIANCE=0.10
